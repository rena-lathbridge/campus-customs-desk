# Copy to .env at the repository root and fill in your own key.
# The real .env is git-ignored and is never committed.

# Portkey gateway key. Every agent reaches the model through Portkey.
PORTKEY_API_KEY=pk-your-portkey-key-here

# Optional overrides — the defaults are what this project was built and run with.
# MODEL_NAME=gpt-6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# CC_REQUEST_LIMIT=60
# CC_TOOL_CALLS_LIMIT=80
# CC_MAX_DELEGATION_DEPTH=3
